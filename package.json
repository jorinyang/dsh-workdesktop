{
  "name": "dsh-workdesktop",
  "version": "1.5.4",
  "private": false,
  "description": "A local-first workbench panel for DeepSeek Harness (DSH). Ships dsh-workbench-v1: the 1.1 workbench (collector / processor / storage engines, a per-day conversation view of messages, a six-block cockpit, and the Project Graph panel).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "pg-helper",
    "assets",
    "coords",
    "modeling",
    "mi-remote",
    "cordis.patch.yml",
    "README.md",
    "selftest.mjs",
    "selftest",
    "selftest-project-graph.mjs",
    "selftest-project-graph-client.mjs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "DSH Workdesktop contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorinyang/dsh-workdesktop.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "workbench",
    "dashboard",
    "local-first"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
