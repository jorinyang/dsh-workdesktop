{
  "name": "dsh-workdesktop",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first workbench panel for DeepSeek Harness (DSH): system/device status, calendar & todos from your local CLIs, recent recordings, local knowledge base, and an object-centric layer (disposition ledger + cross-source checks).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "DSH Workdesktop contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorinyang/dsh-workdesktop.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "workbench",
    "dashboard",
    "local-first"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
